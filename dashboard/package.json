{
  "name": "planrace-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "build": "npm run verify:evidence && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "node --test scripts/evidence.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@polkadot/util-crypto": "14.0.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
