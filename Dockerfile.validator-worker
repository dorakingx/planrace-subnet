FROM python:3.12.13-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="PlanRace validator worker" \
    org.opencontainers.image.description="Network-isolated SQL benchmark worker for PlanRace protocol v2" \
    org.opencontainers.image.source="https://github.com/dorakingx/planrace-subnet" \
    org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.revision="${VCS_REF}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/planrace

WORKDIR /opt/planrace
COPY requirements.worker.txt /opt/planrace/requirements.worker.txt
RUN pip install --no-cache-dir --no-compile --root-user-action=ignore \
    --require-hashes --requirement requirements.worker.txt
COPY --chown=65532:65532 planrace /opt/planrace/planrace

USER 65532:65532
ENTRYPOINT ["python", "-m", "planrace.sandbox_worker"]
